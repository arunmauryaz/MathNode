{
  "id": "user.example.whole-square",
  "name": "Whole Square",
  "category": "My Nodes",
  "icon": "function",
  "badge": "CREATED",
  "description": "Computes (A + B)^2; expands to the original five-node graph.",
  "inputs": [
    {
      "name": "a",
      "type": "scalar",
      "description": "Output scalar value",
      "label": "A",
      "default": 2,
      "connectable": true,
      "widget": "number"
    },
    {
      "name": "b",
      "type": "scalar",
      "description": "Output scalar value",
      "label": "B",
      "default": 3,
      "connectable": true,
      "widget": "number"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "label": "Result",
      "type": "scalar",
      "description": "Computed function result"
    }
  ],
  "composite": {
    "version": 1,
    "nodes": [
      {
        "id": "node-demo-val1",
        "definitionId": "math.value",
        "type": "math.value",
        "title": "A",
        "x": 0,
        "y": 0,
        "width": 260,
        "height": 186,
        "values": {
          "value": 2
        }
      },
      {
        "id": "node-demo-val2",
        "definitionId": "math.value",
        "type": "math.value",
        "title": "B",
        "x": 0,
        "y": 280,
        "width": 260,
        "height": 186,
        "values": {
          "value": 3
        }
      },
      {
        "id": "node-demo-op",
        "definitionId": "math.operations",
        "type": "math.operations",
        "title": "Math Operation",
        "x": 400,
        "y": 0,
        "width": 250,
        "height": 238,
        "values": {
          "a": 25,
          "b": 17,
          "operation": "Add (+)"
        }
      },
      {
        "id": "node-demo-output",
        "definitionId": "math.output",
        "type": "math.output",
        "title": "Result",
        "x": 1200,
        "y": 100,
        "width": 240,
        "height": 168,
        "values": {
          "input": 42
        }
      },
      {
        "id": "square-function",
        "type": "math.function",
        "definitionId": "math.function",
        "title": "Square",
        "x": 800,
        "y": 40,
        "values": {
          "x": 0,
          "func": "x^2"
        }
      }
    ],
    "connections": [
      {
        "id": "conn-1",
        "fromNodeId": "node-demo-val1",
        "fromSocket": "value",
        "toNodeId": "node-demo-op",
        "toSocket": "a",
        "color": "#60A5FA"
      },
      {
        "id": "conn-2",
        "fromNodeId": "node-demo-val2",
        "fromSocket": "value",
        "toNodeId": "node-demo-op",
        "toSocket": "b",
        "color": "#60A5FA"
      },
      {
        "id": "sum-to-square",
        "fromNodeId": "node-demo-op",
        "fromSocket": "result",
        "toNodeId": "square-function",
        "toSocket": "x",
        "color": "#8B9BB4"
      },
      {
        "id": "square-to-result",
        "fromNodeId": "square-function",
        "fromSocket": "result",
        "toNodeId": "node-demo-output",
        "toSocket": "input",
        "color": "#8B9BB4"
      }
    ],
    "frames": [],
    "definitions": [
      {
        "id": "math.value",
        "name": "Value",
        "category": "Basic Math",
        "badge": "VALUE",
        "icon": "slider",
        "description": "Generates a numeric scalar value with direct input and range slider",
        "inputs": [],
        "outputs": [
          {
            "name": "value",
            "type": "scalar",
            "description": "Output scalar value"
          }
        ],
        "code": "(inputs) => {\n  return { value: Number(inputs.value ?? 10) };\n}"
      },
      {
        "id": "math.operations",
        "name": "Math Operation",
        "category": "Basic Math",
        "badge": "OPERATOR",
        "icon": "multiply",
        "description": "Calculates arithmetic operation between two values: +, -, *, /, ^, %",
        "inputs": [
          {
            "name": "a",
            "type": "scalar",
            "default": 0,
            "widget": "number",
            "description": "Operand A"
          },
          {
            "name": "b",
            "type": "scalar",
            "default": 0,
            "widget": "number",
            "description": "Operand B"
          },
          {
            "name": "operation",
            "connectable": false,
            "type": "string",
            "default": "Add (+)",
            "widget": "dropdown",
            "options": [
              "Add (+)",
              "Subtract (-)",
              "Multiply (*)",
              "Divide (/)",
              "Power (^)",
              "Modulo (%)"
            ],
            "description": "Arithmetic operator"
          }
        ],
        "outputs": [
          {
            "name": "result",
            "type": "scalar",
            "description": "Computed arithmetic result"
          }
        ],
        "code": "(inputs, math) => ({ result: math.operate(String(inputs.operation || 'Add (+)'), inputs.a ?? 0, inputs.b ?? 0) })"
      },
      {
        "id": "math.output",
        "name": "View Result",
        "category": "Display & Output",
        "badge": "RESULT",
        "icon": "output",
        "description": "Digital instrument display that inspects and displays live results",
        "inputs": [
          {
            "name": "input",
            "type": "any",
            "default": 0,
            "description": "Incoming data to display"
          }
        ],
        "outputs": [],
        "code": "(inputs) => {\n  return { output: inputs.input ?? 0 };\n}"
      },
      {
        "id": "math.function",
        "name": "Math Function",
        "category": "Basic Math",
        "badge": "FUNCTION",
        "icon": "function",
        "description": "Calculates sin, cos, tan, sqrt, abs, ln, exp of an input value",
        "inputs": [
          {
            "name": "x",
            "type": "scalar",
            "default": 0,
            "widget": "number",
            "description": "Input value x"
          },
          {
            "name": "func",
            "connectable": false,
            "type": "string",
            "default": "sin(x)",
            "widget": "dropdown",
            "options": [
              "sin(x)",
              "cos(x)",
              "tan(x)",
              "sqrt(x)",
              "abs(x)",
              "ln(x)",
              "exp(x)",
              "x^2"
            ],
            "description": "Mathematical function"
          }
        ],
        "outputs": [
          {
            "name": "result",
            "type": "scalar",
            "description": "Computed function result"
          }
        ],
        "code": "(inputs, math) => ({ result: math.applyFunction(String(inputs.func || 'sin(x)'), inputs.x ?? 0) })"
      }
    ],
    "inputs": [
      {
        "name": "a",
        "nodeId": "node-demo-val1",
        "socket": "value",
        "mode": "output"
      },
      {
        "name": "b",
        "nodeId": "node-demo-val2",
        "socket": "value",
        "mode": "output"
      }
    ],
    "outputs": [
      {
        "name": "result",
        "nodeId": "node-demo-output",
        "socket": "output",
        "mode": "output"
      }
    ]
  }
}