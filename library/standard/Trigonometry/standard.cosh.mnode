{
  "id": "standard.cosh",
  "name": "Hyperbolic Cosine",
  "folderId": "standard-1",
  "category": "Trigonometry",
  "badge": "MATH",
  "icon": "function",
  "description": "Hyperbolic Cosine. Angles use radians; numeric collection operations require assigned values.",
  "inputs": [
    {
      "name": "x",
      "type": "scalar",
      "default": 0,
      "widget": "number"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "scalar"
    }
  ],
  "code": "(inputs, math) => ({ result: math.call('Cosh',inputs.x) })"
}