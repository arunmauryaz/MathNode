{
  "id": "standard.equal",
  "name": "Numerically Equal",
  "folderId": "standard-5",
  "category": "Logic",
  "badge": "MATH",
  "icon": "function",
  "description": "Numerically Equal. Angles use radians; numeric collection operations require assigned values.",
  "inputs": [
    {
      "name": "a",
      "type": "scalar",
      "default": 2,
      "widget": "number"
    },
    {
      "name": "b",
      "type": "scalar",
      "default": 3,
      "widget": "number"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "bool"
    }
  ],
  "code": "(inputs, math) => ({ result: math.numeric(inputs.a) === math.numeric(inputs.b) })"
}