{
  "id": "standard.vector-subtract",
  "name": "Vector Subtract",
  "folderId": "standard-4",
  "category": "Vectors & Matrices",
  "badge": "MATH",
  "icon": "function",
  "description": "Vector Subtract. Angles use radians; numeric collection operations require assigned values.",
  "inputs": [
    {
      "name": "a",
      "type": "vector",
      "default": [
        1,
        2,
        3
      ]
    },
    {
      "name": "b",
      "type": "vector",
      "default": [
        1,
        2,
        3
      ]
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "vector"
    }
  ],
  "code": "(inputs, math) => ({ result: math.collections.vectorOp(inputs.a,inputs.b,'subtract') })"
}