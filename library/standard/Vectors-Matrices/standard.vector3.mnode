{
  "id": "standard.vector3",
  "name": "Vector 3D",
  "folderId": "standard-4",
  "category": "Vectors & Matrices",
  "badge": "MATH",
  "icon": "function",
  "description": "Vector 3D. Angles use radians; numeric collection operations require assigned values.",
  "inputs": [
    {
      "name": "x",
      "type": "scalar",
      "default": 1,
      "widget": "number"
    },
    {
      "name": "y",
      "type": "scalar",
      "default": 2,
      "widget": "number"
    },
    {
      "name": "z",
      "type": "scalar",
      "default": 3,
      "widget": "number"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "vector"
    }
  ],
  "code": "(inputs, math) => ({ result: [math.numeric(inputs.x),math.numeric(inputs.y),math.numeric(inputs.z)] })"
}