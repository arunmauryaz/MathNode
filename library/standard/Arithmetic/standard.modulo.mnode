{
  "id": "standard.modulo",
  "name": "Modulo",
  "folderId": "standard-0",
  "category": "Arithmetic",
  "badge": "MATH",
  "icon": "function",
  "description": "Modulo. Angles use radians; numeric collection operations require assigned values.",
  "inputs": [
    {
      "name": "a",
      "type": "scalar",
      "default": 2,
      "widget": "number"
    },
    {
      "name": "b",
      "type": "scalar",
      "default": 3,
      "widget": "number"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "scalar"
    }
  ],
  "code": "(inputs, math) => ({ result: math.operate('%',inputs.a,inputs.b) })"
}