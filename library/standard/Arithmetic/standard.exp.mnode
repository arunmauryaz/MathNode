{
  "id": "standard.exp",
  "name": "Exponential",
  "folderId": "standard-0",
  "category": "Arithmetic",
  "badge": "MATH",
  "icon": "function",
  "description": "Exponential. Angles use radians; numeric collection operations require assigned values.",
  "inputs": [
    {
      "name": "x",
