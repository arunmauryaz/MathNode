{
  "id": "standard.factorial",
  "name": "Factorial",
  "folderId": "standard-0",
  "category": "Arithmetic",
  "badge": "MATH",
  "icon": "function",
  "description": "Factorial. Angles use radians; numeric collection operations require assigned values.",
  "inputs": [
    {
      "name": "n",
      "type": "scalar",
      "default": 5,
      "widget": "number"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "scalar"
    }
  ],
  "code": "(inputs, math) => ({ result: math.collections.factorial(math.numeric(inputs.n)) })"
}