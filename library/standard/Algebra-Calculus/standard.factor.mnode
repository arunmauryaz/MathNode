{
  "id": "standard.factor",
  "name": "Factor",
  "folderId": "standard-2",
  "category": "Algebra & Calculus",
  "badge": "FORMULA",
  "icon": "function",
  "description": "Factor. Accepts symbolic formulas and LaTeX.",
  "inputs": [
    {
      "name": "expression",
      "type": "scalar",
      "default": "(A+B)^2",
      "widget": "number"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "scalar"
    }
  ],
  "code": "(inputs, math) => ({ result: math.transform(inputs.expression,'Factor') })"
}