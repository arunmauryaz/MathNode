{
  "id": "standard.stats-mean",
  "name": "Mean",
  "folderId": "standard-3",
  "category": "Statistics",
  "badge": "MATH",
  "icon": "function",
  "description": "Mean. Angles use radians; numeric collection operations require assigned values.",
  "inputs": [
    {
      "name": "data",
      "type": "vector",
      "default": [
        1,
        2,
        3,
        4
      ]
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "scalar"
    }
  ],
  "code": "(inputs, math) => ({ result: math.collections.stats(inputs.data,'mean') })"
}